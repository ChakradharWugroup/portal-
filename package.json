{
  "name": "internal-portal-workspace",
  "version": "1.0.0",
  "description": "Smart Enterprise AI Platform Workspace",
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "start:frontend": "npm run dev --prefix frontend",
    "start:backend": "npm run start --prefix backend",
    "start:backend:dev": "npm run start:dev --prefix backend",
    "start:ai": "cd ai-service && python -m uvicorn app.main:app --reload --port 8000"
  }
}
